{
  "name": "@hopenetwork/wallet",
  "version": "0.3.7",
  "type": "module",
  "license": "MIT",
  "description": "Hope Wallet SDK: connect, message QR, and PQ mnemonic sign+broadcast.",
  "keywords": ["hope", "wallet", "cosmos", "qr", "post-quantum"],
  "homepage": "https://hopenetwork.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hope-Network-Org/hope-node.git",
    "directory": "wallet"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "test": "npx tsx src/protocol.test.ts && npx tsx src/connect.test.ts && npx tsx src/qr.test.ts && npx tsx src/node/encode.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "@hope/pq": ">=0.1.0",
    "@hope/tx": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "@hope/pq": { "optional": true },
    "@hope/tx": { "optional": true }
  },
  "devDependencies": {
    "@hope/pq": "file:../../hope-wallet/packages/hope-pq",
    "@hope/tx": "file:../../hope-wallet/packages/hope-tx",
    "@types/qrcode": "^1.5.5",
    "@types/react": ">=18",
    "tsx": "^4.22.4",
    "tsup": "^8.5.0",
    "typescript": "~5.6.3"
  }
}
